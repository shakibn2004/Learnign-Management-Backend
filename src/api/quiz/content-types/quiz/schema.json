{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "passingScore": {
      "type": "integer",
      "default": 70
    },
    "questions": {
      "type": "json"
    },
    "courseId": {
      "type": "string"
    },
    "course": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course.course",
      "mappedBy": "quiz"
    }
  }
}
