{
  "kind": "collectionType",
  "collectionName": "lms_users",
  "info": {
    "singularName": "lms-user",
    "pluralName": "lms-users",
    "displayName": "LMS User",
    "description": "LMS Users list for role switcher simulation"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "Admin",
        "Content Manager",
        "Instructor",
        "Student"
      ],
      "required": true
    },
    "avatar": {
      "type": "string"
    },
    "enrolledCourseIds": {
      "type": "json"
    },
    "password": {
      "type": "string"
    }
  }
}
