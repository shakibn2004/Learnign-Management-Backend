{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "durationMinutes": {
      "type": "integer"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "video",
        "text"
      ],
      "default": "text"
    },
    "videoUrl": {
      "type": "string"
    },
    "content": {
      "type": "text"
    },
    "order": {
      "type": "integer",
      "default": 1
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "lessons"
    }
  }
}
